# ── Database (Prisma Postgres) ──────────────────────────────────────────────
# DATABASE_URL: pooled connection — used at runtime (API routes, tests).
# DIRECT_URL: unpooled connection — used only for `prisma db push`/migrate.
# Local dev: both point at the CaptureGuard-dev database (Prisma Console →
# your database → Connect). Production (CaptureGuard-prod) is configured
# only in Vercel's environment variables, never committed here.
DATABASE_URL="postgres://<user>:<password>@pooled.db.prisma.io:5432/<database>?sslmode=require"
DIRECT_URL="postgres://<user>:<password>@db.prisma.io:5432/<database>?sslmode=require"

# ── Database (automated test suite — CaptureGuard-test) ────────────────────
# Read ONLY by the test harness (scripts/setup-test-db.mjs, tests/setup/env.ts)
# — never by `npm run dev`. Keeps tests fully isolated from CaptureGuard-dev
# and CaptureGuard-prod: `npm test` resets and pushes against this database
# only, every run.
TEST_DATABASE_URL="postgres://<user>:<password>@pooled.db.prisma.io:5432/<database>?sslmode=require"
TEST_DIRECT_URL="postgres://<user>:<password>@db.prisma.io:5432/<database>?sslmode=require"

# ── Razorpay (Test Mode) ────────────────────────────────────────────────────
# From Dashboard → Settings → API Keys (Test Mode).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From Dashboard → Settings → Webhooks, when you register the webhook URL.
RAZORPAY_WEBHOOK_SECRET=""

# ── Internal dashboard auth ─────────────────────────────────────────────────
# Server-to-server bearer token (scripts, CI, direct API callers) — every
# protected /api/* route accepts EITHER this OR a valid browser session
# (see below). The browser itself never sends this. Generate any long
# random string for local dev.
INTERNAL_API_TOKEN=""

# ── Browser session auth ────────────────────────────────────────────────────
# SESSION_SECRET: seals the HttpOnly session cookie (iron-session). Must be
# 32+ random chars, e.g. `openssl rand -base64 32`.
# ADMIN_PASSWORD_HASH: the merchant operator's login password, hashed — never
# store the plaintext. Generate with:
#   npx tsx scripts/hash-admin-password.ts "your chosen password"
SESSION_SECRET=""
ADMIN_PASSWORD_HASH=""

# ── AI provider (optional) ──────────────────────────────────────────────────
# AI_PROVIDER=none | anthropic | openai | gemini
# With AI_PROVIDER=none (or unset), the app runs fully on the deterministic
# keyword-fallback matcher — this is a supported, intentional mode, not a
# degraded one.
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL=""

# ── Policy defaults ──────────────────────────────────────────────────────────
# Only a fallback default used when seeding the merchant row — the value the
# Decision Engine actually reads lives in merchants.auto_reversal_window_hours
# and is editable from the Admin/Config screen without a redeploy.
AUTO_REVERSAL_WINDOW_HOURS_DEFAULT="24"
