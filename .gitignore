# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is intentionally NOT ignored: it documents every
# required variable with no real values (Section 13), and should be committed.
.env*
!.env.example

# vercel
.vercel

# database (local dev)
*.db
*.db-journal
/prisma/dev.db*

# typescript
*.tsbuildinfo
next-env.d.ts
