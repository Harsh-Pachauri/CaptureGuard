# ── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite, no external service needed): file:./prisma/dev.db
# Deployment (Supabase/Postgres): postgresql://user:password@host:5432/postgres
# (also flip `provider` in prisma/schema.prisma from "sqlite" to "postgresql")
DATABASE_URL="file:./prisma/dev.db"

# ── Razorpay (Test Mode) ────────────────────────────────────────────────────
# From Dashboard → Settings → API Keys (Test Mode).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From Dashboard → Settings → Webhooks, when you register the webhook URL.
RAZORPAY_WEBHOOK_SECRET=""

# ── Internal dashboard auth ─────────────────────────────────────────────────
# A single shared bearer token every /api/* route (except the webhook
# receiver) requires. Generate any long random string for local dev.
INTERNAL_API_TOKEN=""

# ── AI provider (optional) ──────────────────────────────────────────────────
# AI_PROVIDER=none | anthropic | openai | gemini
# With AI_PROVIDER=none (or unset), the app runs fully on the deterministic
# keyword-fallback matcher — this is a supported, intentional mode, not a
# degraded one.
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL=""

# ── Policy defaults ──────────────────────────────────────────────────────────
# Only a fallback default used when seeding the merchant row — the value the
# Decision Engine actually reads lives in merchants.auto_reversal_window_hours
# and is editable from the Admin/Config screen without a redeploy.
AUTO_REVERSAL_WINDOW_HOURS_DEFAULT="24"
